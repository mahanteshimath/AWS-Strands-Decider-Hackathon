<mxfile host="drawio" version="26.0.0"><diagram name="system-architecture"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="880" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="TariffTrail: system architecture" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontColor=#1f2933;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="700" height="30" as="geometry"/></mxCell><mxCell id="n3" value="A calibrated 2B model makes many small choices; one short LLM call chooses among real codes; a Strands intervention guards the action." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#5f6b76;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="44" width="1100" height="22" as="geometry"/></mxCell><mxCell id="n4" value="Importer / broker" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fontColor=#1f2933;strokeColor=#666666;fillColor=#f5f5f5;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="44" height="84" as="geometry"/></mxCell><mxCell id="n5" value="Strands Agent" style="swimlane;startSize=34;whiteSpace=wrap;html=1;rounded=1;arcSize=3;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f2933;fontSize=13;fontStyle=1;strokeWidth=1.5;swimlaneFillColor=#ffffff;collapsible=0;" vertex="1" parent="1"><mxGeometry x="140" y="120" width="270" height="360" as="geometry"/></mxCell><mxCell id="n6" value='&lt;b&gt;classify_product&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5f6b76"&gt;product facts → HTS code + alternatives&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1f2933;fontSize=12;strokeWidth=1.5;" vertex="1" par