<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0"><diagram name="guardrail-flow"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="1110" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="ClassificationGate: guarding the one action with consequences" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontColor=#1f2933;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1000" height="30" as="geometry"/></mxCell><mxCell id="n3" value="A Strands InterventionHandler on file_entry. Checks 1 and 2 are plain code; check 3 is a second Decider decision." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#5f6b76;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="44" width="1050" height="22" as="geometry"/></mxCell><mxCell id="n4" value='&lt;b&gt;Agent calls file_entry(hts_code, description)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5f6b76"&gt;the tool call is intercepted before it runs&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f2933;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="340" y="90" width="360" height="64" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;1&lt;/b&gt; Is the code a real line of the current HTS?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1f2933;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="320" y="190" width="400" height="140" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;2&lt;/b&gt; Did this code come from classify_product in this session?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1f2933;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="320" y="370" width="400" height="140" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;3&lt;/b&gt; Decider &lt;i&gt;noul&lt;/i&gt;: does the entry describe the classified goods? (p ≥ 0.5)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1f2933;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="320" y="550" width="400" height="140" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;4&lt;/b&gt; Do Decider, Bedrock and the nearest past rulings agree on the code?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1f2933;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="320" y="730" width="400" height="140" as="geometry"/></mxCell><mxCell id="n9" value='&lt;b&gt;Deny&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5f6b76"&gt;“not a line in the current HTS”&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1f2933;fontSize=12;strokeWidth=1.5;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="800" y="229" width="260" height="62" as="geometry"/></mxCell><mxCell id="n10" value='&lt;b&gt;Guide&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5f6b76"&gt;“only file codes from classify_product; classify first”&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1f2933;fontSize=12;strokeWidth=1.5;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="800" y="409" width="260" height="62" as="geometry"/></mxCell><mxCell id="n11" value='&lt;b&gt;Guide&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5f6b76"&gt;“describe the same goods, or classify the new description”&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1f2933;fontSize=12;strokeWidth=1.5;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="800" y="589" width="260" height="62" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;Confirm · FAST-TRACK&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5f6b76&quot;&gt;front of the broker's queue&lt;br&gt;16% of test products, 76% correct&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1f2933;fontSize=12;strokeWidth=1.5;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="20" y="764" width="240" height="72" as="geometry"/></mxCell><mxCell id="n13" value='&lt;b&gt;Confirm · DISPUTED&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5f6b76"&gt;shows the alternatives considered&lt;br&gt;the other 84%: 29% correct&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1f2933;fontSize=12;strokeWidth=1.5;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="800" y="764" width="260" height="72" as="geometry"/></mxCell><mxCell id="n14" value='&lt;b&gt;Licensed broker answers yes / no&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5f6b76"&gt;yes → the entry is filed · no → nothing is filed&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1f2933;fontSize=12;strokeWidth=1.5;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="340" y="950" width="360" height="70" as="geometry"/></mxCell><mxCell id="n15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4a5568;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#1f2933;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n4" target="n5"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n16" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#1f2933;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n5" target="n9"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n17" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4a5568;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#1f2933;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n5" target="n6"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n18" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d6b656;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#1f2933;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n6" target="n10"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n19" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4a5568;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#1f2933;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n6" target="n7"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n20" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d6b656;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#1f2933;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7" target="n11"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n21" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4a5568;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#1f2933;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7" target="n8"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n22" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#1f2933;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n12"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n23" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d79b00;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#1f2933;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n13"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#1f2933;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n12" target="n14"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="140" y="985"/></Array></mxGeometry></mxCell><mxCell id="n25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#1f2933;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n13" target="n14"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="930" y="985"/></Array></mxGeometry></mxCell><mxCell id="n26" value='&lt;b&gt;Tariffs never skip the human&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5f6b76"&gt;TARIFF_POLICY sets auto = 1.01, so “Proceed without a broker” is unreachable for tariff codes. Path probability had AUROC 0.63 on 332 test rulings: informative, not file-safe.&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#1f2933;fontSize=12;strokeWidth=1.5;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="30" y="190" width="280" height="150" as="geometry"/></mxCell><mxCell id="n27" value='&lt;b&gt;Reusable&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5f6b76"&gt;Swap the four checks for your own: the gate only needs a ledger of what the classifier produced and a Decider question per risk.&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#1f2933;fontSize=12;strokeWidth=1.5;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="30" y="380" width="280" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
