<mxfile host="drawio" version="26.0.0"><diagram name="calibrated-tree-descent"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="900" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Calibrated Tree Descent: the reusable pattern" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontColor=#1f2933;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="900" height="30" as="geometry"/></mxCell><mxCell id="n3" value="Real trace of CBP ruling N357194 (an adult Anubis costume, gold code 9505.90.60.00). Each number is Decider's calibrated probability at that fork." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#5f6b76;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="44" width="1300" height="22" as="geometry"/></mxCell><mxCell id="n4" value="Fork 1: seed (headings from similar rulings)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#5f6b76;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="270" y="76" width="270" height="20" as="geometry"/></mxCell><mxCell id="n5" value="Fork 2: inside heading 9505" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#5f6b76;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="560" y="76" width="270" height="20" as="geometry"/></mxCell><mxCell id="n6" value="Fork 3: inside 9505.90" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#5f6b76;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="890" y="76" width="270" height="20" as="geometry"/></mxCell><mxCell id="n7" value='&lt;b&gt;Seed fork&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5f6b76"&gt;8 headings proposed from the 20 nearest past rulings&lt;br&gt;+ none_of_these&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f2933;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="250" width="200" height="92" as="geometry"/></mxCell><mxCell id="n8" value='&lt;b&gt;9505 Festive, carnival…&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5f6b76"&gt;p = 0.48 · path 0.48&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1f2933;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="270" y="180" width="240" height="62" as="geometry"/></mxCell><mxCell id="n9" value='&lt;b&gt;none_of_these&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5f6b76"&gt;p = 0.52 → full walk from the root&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1f2933;fontSize=12;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="270" y="380" width="240" height="62" as="geometry"/></mxCell><mxCell id="n10" value='&lt;b&gt;9505.90 Other (not covered by…)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5f6b76"&gt;p = 0.38 · path 0.18&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1f2933;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="560" y="120" width="260" height="62" as="geometry"/></mxCell><mxCell id="n11" value='&lt;b&gt;9505.10 Christmas articles&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5f6b76"&gt;p = 0.18 · path 0.09&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#1f2933;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="560" y="210" width="260" height="62" as="geometry"/></mxCell><mxCell id="n12" value='&lt;b&gt;none_of_these&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5f6b76"&gt;p = 0.44 · subtree paths are scaled down&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1f2933;fontSize=12;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="560" y="300" width="260" height="62" as="geometry"/></mxCell><mxCell id="n13" value='&lt;b&gt;9505.90.60.00 Other  ✔ leaf&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5f6b76"&gt;p = 0.69 · path 0.13 = the gold code&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1f2933;fontSize=12;strokeWidth=1.5;strokeWidth=3;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="890" y="104" width="260" height="66" as="geometry"/></mxCell><mxCell id="n14" value='&lt;b&gt;9505.90.20.00 Magic tricks&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5f6b76"&gt;p = 0.11 · path 0.02&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#1f2933;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="890" y="190" width="260" height="56" as="geometry"/></mxCell><mxCell id="n15" value='&lt;b&gt;none_of_these&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5f6b76"&gt;p = 0.20&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1f2933;fontSize=12;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="890" y="264" width="260" height="50" as="geometry"/></mxCell><mxCell id="n16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4a5568;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#1f2933;labelBackgroundColor=#ffffff;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7" target="n8"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#1f2933;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7" target="n9"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4a5568;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#1f2933;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n10"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4a5568;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#1f2933;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n11"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#1f2933;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n12"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4a5568;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#1f2933;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n10" target="n13"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4a5568;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#1f2933;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n10" target="n14"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#1f2933;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n10" target="n15"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n24" value="Frontier: a priority queue ordered by path probability" style="swimlane;startSize=40;whiteSpace=wrap;html=1;rounded=1;arcSize=3;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#1f2933;fontSize=13;fontStyle=1;strokeWidth=1.5;swimlaneFillColor=#ffffff;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1190" y="70" width="340" height="260" as="geometry"/></mxCell><mxCell id="n25" value='&lt;b&gt;0.13 · 9505.90.60.00&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5f6b76"&gt;leaf → becomes candidate #1&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1f2933;fontSize=12;strokeWidth=1.5;strokeWidth=2.5;strokeColor=#d79b00;" vertex="1" parent="n24"><mxGeometry x="20" y="52" width="300" height="46" as="geometry"/></mxCell><mxCell id="n26" value='&lt;b&gt;0.09 · 9505.10 Christmas&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5f6b76"&gt;expand next if budget allows&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#1f2933;fontSize=12;strokeWidth=1.5;" vertex="1" parent="n24"><mxGeometry x="20" y="106" width="300" height="46" as="geometry"/></mxCell><mxCell id="n27" value='&lt;b&gt;0.02 · 9505.90.20.00&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5f6b76"&gt;leaf → candidate #3&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#1f2933;fontSize=12;strokeWidth=1.5;" vertex="1" parent="n24"><mxGeometry x="20" y="160" width="300" height="46" as="geometry"/></mxCell><mxCell id="n28" value="…and the other seeded headings" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#5f6b76;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="n24"><mxGeometry x="20" y="212" width="300" height="20" as="geometry"/></mxCell><mxCell id="n29" value='&lt;b&gt;A wrong turn fixes itself&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5f6b76"&gt;On a wrong branch Decider puts most of its mass on none_of_these, so every path below it collapses and the search resumes at the next-best path anywhere in the tree. No hand-written backtracking.&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1f2933;fontSize=12;strokeWidth=1.5;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1190" y="345" width="340" height="130" as="geometry"/></mxCell><mxCell id="n30" value="Then the pattern hands a few real candidates to the rest of the system" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2933;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="540" width="900" height="24" as="geometry"/></mxCell><mxCell id="n31" value="&lt;b&gt;1 · Top 3 complete paths&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5f6b76&quot;&gt;plus the nearest past ruling's code&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1f2933;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="580" width="330" height="84" as="geometry"/></mxCell><mxCell id="n32" value='&lt;b&gt;2 · One LLM call&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5f6b76"&gt;Amazon Nova Pro chooses among real codes only&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d3efe9;strokeColor=#01A88D;fontColor=#1f2933;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="410" y="580" width="330" height="84" as="geometry"/></mxCell><mxCell id="n33" value='&lt;b&gt;3 · Agreement decides the queue&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5f6b76"&gt;Decider ∧ Bedrock ∧ past rulings agree → fast-track&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1f2933;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="790" y="580" width="330" height="84" as="geometry"/></mxCell><mxCell id="n34" value='&lt;b&gt;4 · A human confirms&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5f6b76"&gt;tariffs never auto-file (auto bar = 1.01)&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1f2933;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1170" y="580" width="330" height="84" as="geometry"/></mxCell><mxCell id="n35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2d6a4f;strokeWidth=2.5;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#1f2933;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n31" target="n32"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2d6a4f;strokeWidth=2.5;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#1f2933;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n32" target="n33"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2d6a4f;strokeWidth=2.5;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#1f2933;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n33" target="n34"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n38" value="&lt;b&gt;Why path probability?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5f6b76&quot;&gt;Every fork sums to 1, so the product along a path is comparable across the entire tree. That gives free backtracking and one number to measure as 'safe to act'.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#1f2933;fontSize=12;strokeWidth=1.5;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="30" y="710" width="740" height="90" as="geometry"/></mxCell><mxCell id="n39" value='&lt;b&gt;Measured, not assumed&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#5f6b76"&gt;Safe on a 48-tool catalog (17/17 confident calls right). On the 8-level tariff tree path probability was only modestly predictive (AUROC 0.63), so TariffTrail never auto-files.&lt;/font&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#1f2933;fontSize=12;strokeWidth=1.5;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="800" y="710" width="730" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
